# نمونه متغیرهای محیطی — مقدار واقعی را در .env.local بگذارید و هرگز در گیت ثبت نکنید (NFR-SEC-06)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# پایگاه داده (M1.2) — PostgreSQL در DBngin: کاربر postgres، بدون رمز، پورت ۵۴۳۲ (D-010)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/lujan_store?statusColor=007F3D&env=local&name=lujan_store&tLSMode=0&usePrivateKey=false&safeModeLevel=0&advancedSafeModeLevel=0&driverVersion=0&lazyload=false"
# از M1.4:
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=
# REDIS_URL=redis://localhost:6379

# ورود (M1.6): کلید تصادفی حداقل ۳۲ نویسه — تولید: openssl rand -base64 48
AUTH_SECRET=
# پیامک (D-019، D-064): dev = چاپ کد در ترمینال؛ smsir = ارسال واقعی با SMS.ir (docs/09-operations/04-sms-payment.md)
SMS_PROVIDER=dev
SMSIR_API_KEY=
# شناسه‌ی عددی قالب کد ورود (پنل SMS.ir ← ارسال سریع) و نام پارامتر کد در آن (#CODE#)
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAM=CODE
# شماره‌ی خط برای پیامک‌های سفارش و موجودی
SMSIR_LINE_NUMBER=
# درگاه پرداخت (D-023، D-065): mock = صفحه‌ی آزمایشی؛ zarinpal = درگاه واقعی
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
# 1 = sandbox زرین‌پال (پولی جابه‌جا نمی‌شود)؛ روز افتتاح خالی
ZARINPAL_SANDBOX=
# روی سرور مسیر کامل بیرون از پوشه‌ی کد (docs/09-operations/01-deploy.md)؛ خالی = web/storage و web/backups
UPLOAD_DIR=
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
# نمایه شدن در گوگل: فقط روز انتشار روی سرور اصلی on شود (robots.ts)
SEO_INDEX=off
# کلید نشانی دریافت پیامک «لغو۱» از سرویس پیامک (دست‌کم ۱۶ نویسه‌ی تصادفی) — D-055
SMS_INBOUND_KEY=
# آمار بازدید Umami روی سرور خودمان (D-054)؛ خالی = غیرفعال
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# تعداد پراکسی‌های خودمان جلوی سایت (nginx = 1). IP از X-Forwarded-For فقط به این اندازه خوانده می‌شود (D-022)
TRUSTED_PROXY_HOPS=1
